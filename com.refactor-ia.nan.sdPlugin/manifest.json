{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.refactor-ia.nan",
  "Name": "NaN Dashboard",
  "Version": "1.0.10.0",
  "Author": "Refactor IA",
  "URL": "https://github.com/refactor-ia/streamdeck-nan",
  "Description": "Track your NaN Dashboard AI usage from Stream Deck: a Stream Deck+ dial plus keypad actions for quota, per-model consumption and total/monthly tokens. Imports your NaN session securely from Chrome. Includes Claude, Codex and an experimental Grok monitor.",
  "Icon": "imgs/plugin/nan-dashboard",
  "Category": "NaN Dashboard",
  "CategoryIcon": "imgs/plugin/nan-category",
  "CodePath": "bin/plugin.js",
  "PropertyInspectorPath": "ui/property-inspector.html",
  "SDKVersion": 3,
  "Nodejs": {
    "Version": "24"
  },
  "Actions": [
    {
      "UUID": "com.refactor-ia.nan.claude",
      "Name": "External \u00b7 Claude Usage",
      "Icon": "imgs/actions/claude/claude",
      "Tooltip": "Shows Claude Code usage limits",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/claude.json",
        "TriggerDescription": {
          "Push": "Open Claude Console",
          "Touch": "Refresh data"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/claude"
        }
      ]
    },
    {
      "UUID": "com.refactor-ia.nan.codex",
      "Name": "External \u00b7 GPT / OpenAI Usage",
      "Icon": "imgs/actions/codex/codex",
      "Tooltip": "Shows GPT/OpenAI usage limits from Codex",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/openai.json",
        "TriggerDescription": {
          "Push": "Open OpenAI usage",
          "Touch": "Refresh data"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/codex"
        }
      ]
    },
    {
      "UUID": "com.refactor-ia.nan.grok",
      "Name": "External \u00b7 Grok Usage (Experimental)",
      "Icon": "imgs/actions/grok/grok",
      "Tooltip": "Shows experimental Grok Build billing usage",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/grok.json",
        "TriggerDescription": {
          "Touch": "Refresh data"
        }
      },
      "States": [
        {
          "Image": "imgs/plugin/plugin-icon"
        }
      ]
    },
    {
      "UUID": "com.refactor-ia.nan.nan-demo",
      "Name": "NaN Usage",
      "Icon": "imgs/actions/nan-usage/nan-usage",
      "Tooltip": "Shows NaN Dashboard quota",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/nan.json",
        "TriggerDescription": {
          "Touch": "Refresh dashboard quota"
        }
      },
      "States": [
        {
          "Image": "imgs/plugin/plugin-icon"
        }
      ]
    },
    {
      "UUID": "com.refactor-ia.nan.nan-model-usage",
      "Name": "NaN Model Usage",
      "Icon": "imgs/actions/nan-model-usage/nan-model-usage",
      "Tooltip": "Shows NaN Dashboard consumption for one selected model",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/nan-model/nan-model"
        }
      ]
    },
    {
      "UUID": "com.refactor-ia.nan.nan-total-tokens",
      "Name": "NaN Total Tokens",
      "Icon": "imgs/actions/nan-total-tokens/nan-total-tokens",
      "Tooltip": "Shows all-time NaN Dashboard tokens",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/nan-model/nan-model"
        }
      ]
    },
    {
      "UUID": "com.refactor-ia.nan.nan-monthly-tokens",
      "Name": "NaN Monthly Tokens",
      "Icon": "imgs/actions/nan-monthly-tokens/nan-monthly-tokens",
      "Tooltip": "Shows month-to-date NaN Dashboard tokens",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/nan-model/nan-model"
        }
      ]
    },
    {
      "UUID": "com.refactor-ia.nan.nan-dashboard",
      "Name": "NaN Dashboard",
      "Icon": "imgs/plugin/nan-dashboard",
      "Tooltip": "Open NaN Dashboard",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/plugin/nan-dashboard"
        }
      ]
    }
  ],
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Software": {
    "MinimumVersion": "7.1"
  },
  "SupportURL": "https://github.com/refactor-ia/streamdeck-nan/issues"
}
